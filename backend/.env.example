# SMTP (Hetzner email for cabscode.pro)
SMTP_HOST=mail.example.host
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=services@cabscode.pro
SMTP_PASS=your_smtp_password

# Branded sender + where to deliver form submissions
MAIL_FROM=services@cabscode.pro
CONTACT_EMAIL=services@cabscode.pro

# Cloudflare Turnstile (spam protection)
# Get these from https://dash.cloudflare.com → Turnstile
TURNSTILE_SITE_KEY=0x4AAAAAAAAAAAAAAA
TURNSTILE_SECRET_KEY=0x4AAAAAAAAAAAAAAA

# SEO Audit (Serper + Gemini)
# Serper: https://serper.dev/ — 2500 free queries, X-API-KEY header
SERPER_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PAID_AUDIT_SECRET=change-me-32chars
AUDIT_USAGE_PATH=/app/audit-usage.json
# Admin token for /api/seo-audit/mint-token (if unset, falls back to PAID_AUDIT_SECRET)
ADMIN_TOKEN=change-me-admin-token
