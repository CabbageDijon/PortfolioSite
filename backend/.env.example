# Gmail SMTP — all site mail is sent from this account
GMAIL_USER=cabscodepro@gmail.com
# 16-character Google App Password (NOT your normal Gmail password).
# Requires 2-Step Verification on the account: https://myaccount.google.com/apppasswords
# Spaces are stripped automatically, so "abcd efgh ijkl mnop" is fine.
GMAIL_APP_PASSWORD=
# Where contact/quote/SEO-audit notifications are delivered (defaults to GMAIL_USER)
NOTIFY_EMAIL=cabscodepro@gmail.com

# SEO Audit (Serper + Gemini)
# Serper: https://serper.dev/ — 2500 free queries, X-API-KEY header
SERPER_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PAID_AUDIT_SECRET=change-me-32chars
AUDIT_USAGE_PATH=/app/audit-usage.json
# Admin token for /api/seo-audit/mint-token (if unset, falls back to PAID_AUDIT_SECRET)
ADMIN_TOKEN=change-me-admin-token

# Journal publisher (private /journal-admin page). Set the real value in Dokploy -> Environment.
JOURNAL_PUBLISH_PASSWORD=change-me
